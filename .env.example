# Required: KOSIS OpenAPI key
KOSIS_API_KEY=

# HTTP server settings
FASTMCP_STATELESS_HTTP=true
KOSIS_HOST=0.0.0.0
KOSIS_PORT=8000
KOSIS_MCP_URL=http://localhost:8000

# Local artifact storage
KOSIS_ARTIFACTS_DIR=/tmp/kosis_artifacts
ARTIFACT_STORAGE=local

# Optional PostgreSQL FTS metadata search
POSTGRES_PASSWORD=kosis_dev_password
# DATABASE_URL=postgresql://kosis:kosis_dev_password@localhost:5432/kosis

# Optional Cloudflare R2 artifact hosting
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
R2_REGION=auto

# Optional validation harness only
ANTHROPIC_API_KEY=
