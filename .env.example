# Required: KOSIS OpenAPI key
# Issue at https://kosis.kr/openapi/. If you only want to *use* the public
# hosted endpoint (https://korean-stat-mcp.seolcoding.com/mcp?apiKey=<key>),
# you don't need a local .env at all — just paste your key in the URL.
KOSIS_API_KEY=

# HTTP server settings (only when self-hosting korean-stat-mcp --http)
FASTMCP_STATELESS_HTTP=true
KOSIS_HOST=0.0.0.0
KOSIS_PORT=8000
KOSIS_MCP_URL=http://localhost:8000

# Optional: shorter timeouts when fronting Fly/Cloudflare proxies (60s default).
# Match the hosted instance: 25s per attempt + 1 retry + 1s delay = 51s worst.
# KOSIS_TIMEOUT=25
# KOSIS_MAX_RETRIES=1
# KOSIS_RETRY_DELAY=1

# Local artifact storage
KOSIS_ARTIFACTS_DIR=/tmp/kosis_artifacts

# Optional PostgreSQL FTS metadata search
POSTGRES_PASSWORD=kosis_dev_password
# DATABASE_URL=postgresql://kosis:kosis_dev_password@localhost:5432/kosis

# Optional validation harness only
ANTHROPIC_API_KEY=
