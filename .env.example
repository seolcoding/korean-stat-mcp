# KOSIS MCP Server - Environment Variables
# Copy this file to .env and configure your values

# ============================================
# KOSIS API (Required)
# ============================================
# Get your API key from: https://kosis.kr/openapi/
KOSIS_API_KEY=your_kosis_api_key_here

# ============================================
# PostgreSQL Database (Optional — for full-text metadata search)
# ============================================
# Install with: pip install korean-stat-mcp[postgres]
# If unset, the server falls back to KOSIS API search only.
# POSTGRES_PASSWORD=your_secure_password_here
# DATABASE_URL=postgresql+asyncpg://kosis:${POSTGRES_PASSWORD}@localhost:5432/kosis

# ============================================
# Cloudflare R2 Storage (Optional)
# ============================================
# If not configured, local filesystem is used for artifacts
# Get credentials from: Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kosis-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev
R2_REGION=auto

# ============================================
# Storage Mode
# ============================================
# Options: 'local', 'r2', 'auto'
# - local: Always use local filesystem
# - r2: Always use R2 (fails if not configured)
# - auto: Use R2 if configured, otherwise local
ARTIFACT_STORAGE=auto

# ============================================
# FastMCP Server
# ============================================
FASTMCP_STATELESS_HTTP=true
