# Remote Server Environment Variables Template
# Copy to .env on the remote server: cp .env.remote.example .env

# ============================================
# Tailscale Database Connection
# ============================================
# Mac's Tailscale IP (run `tailscale ip -4` on Mac to verify)
TAILSCALE_DB_HOST=100.x.x.x
POSTGRES_PASSWORD=your_postgres_password

# ============================================
# KOSIS API (Required)
# ============================================
KOSIS_API_KEY=your_kosis_api_key

# ============================================
# OpenAI API (Required for Hybrid Search)
# ============================================
OPENAI_API_KEY=sk-your_openai_api_key

# ============================================
# Cloudflare R2 Storage (Optional)
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kosis-assets
R2_PUBLIC_URL=
R2_REGION=auto

# ============================================
# Storage & Server
# ============================================
ARTIFACT_STORAGE=auto
FASTMCP_STATELESS_HTTP=true
