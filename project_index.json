{
  "project_type": "single",
  "services": {
    "main": {
      "path": ".",
      "tech_stack": ["python", "fastapi", "fastmcp"],
      "port": 8000,
      "dev_command": "python -m uvicorn src.mcp_server.server:app --reload --port 8000",
      "test_command": "python -m pytest tests/",
      "coverage_command": "python -m pytest tests/ --cov=src --cov-report=term-missing"
    }
  },
  "infrastructure": {
    "docker": true,
    "database": "postgresql",
    "storage": "cloudflare_r2"
  },
  "conventions": {
    "linter": "ruff",
    "formatter": "black",
    "testing": "pytest",
    "python_version": "3.12"
  },
  "directories": {
    "source": "src/",
    "tests": "tests/",
    "unit_tests": "tests/unit/",
    "e2e_tests": "tests/e2e/",
    "integration_tests": "tests/integration/"
  }
}
